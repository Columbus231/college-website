ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://college:replace-after-generating-password@localhost:5432/college
POSTGRES_PASSWORD=replace-before-starting
POSTGRES_TEST_PASSWORD=disposable-test-only
JWT_SECRET_KEY=replace-before-starting-with-a-random-secret
REDIS_PASSWORD=replace-before-starting
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
VITE_API_URL=http://127.0.0.1:8000/api/v1
PUBLIC_APP_URL=http://127.0.0.1:5173
PUBLIC_DOMAIN=localhost
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=noreply@example.edu
SMTP_STARTTLS=false
SMTP_SSL=false
CLAMAV_HOST=clamav
RATE_LIMIT_STORAGE_URI=redis://:replace-before-starting@redis:6379/0
UPLOADS_DIRECTORY=uploads
MAX_UPLOAD_BYTES=5000000
